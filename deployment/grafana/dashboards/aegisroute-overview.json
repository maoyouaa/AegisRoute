    {
      "id": 6,
      "type": "timeseries",
      "title": "Serving latency \u00b7 p95",
      "description": "Actual Gateway duration; fixed low-cardinality traffic/outcome labels. No request IDs.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le,traffic)(rate(aegis_serving_seconds_bucket[1m])))",
          "refId": "A",
          "legendFormat": "{{traffic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "Unknown / no evidence",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
