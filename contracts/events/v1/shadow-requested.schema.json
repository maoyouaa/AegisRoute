{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegisroute.dev/contracts/events/v1/shadow-requested.schema.json",
  "title": "ShadowRequestedV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "sampleId", "requestId", "rolloutId", "routeVersion", "candidateDeploymentId", "requestedAt", "request"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "format": "uuid" },
    "sampleId": { "type": "string", "format": "uuid" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "rolloutId": { "type": "string", "format": "uuid" },
    "routeVersion": { "type": "integer", "minimum": 1 },
    "candidateDeploymentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "requestedAt": { "type": "string", "format": "date-time" },
    "request": { "$ref": "#/$defs/chatRequest" }
  },
  "$defs": {
    "chatRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "messages", "stream"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "stream": { "type": "boolean" },
        "max_tokens": { "type": ["integer", "null"], "minimum": 1 },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": { "enum": ["system", "user", "assistant"] },
              "content": { "type": "string", "maxLength": 32768 }
            }
          }
        }
      }
    }
  }
}
